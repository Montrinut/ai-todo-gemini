# Database (Railway จะ set ให้อัตโนมัติเมื่อ add PostgreSQL plugin)
DATABASE_URL=postgresql://user:password@localhost:5432/tododb

# JWT
SECRET_KEY=your-super-secret-key-change-this

# Google Gemini AI
GEMINI_API_KEY=xxxxxxxxxx

# LINE Messaging API
# สร้างได้ที่ https://developers.line.biz → Messaging API → Channel access token
LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxxxx
